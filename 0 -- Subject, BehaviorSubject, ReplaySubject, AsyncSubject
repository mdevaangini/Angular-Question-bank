import { Component } from '@angular/core';
import { CommonModule } from '@angular/common';
import { Subject, BehaviorSubject, ReplaySubject, AsyncSubject, Subscription } from 'rxjs';

type Kind = 'subject' | 'behavior' | 'replay' | 'async';

interface Card {
  kind: Kind;
  title: string;
  desc: string;
  subject: any;
  counter: number;
  completed: boolean;
  subBActive: boolean;
  subASub?: Subscription;
  subBSub?: Subscription;
  logA: string[];
  logB: string[];
  current: string;
}

function makeSubject(kind: Kind) {
  switch (kind) {
    case 'subject': return new Subject<string>();
    case 'behavior': return new BehaviorSubject<string>('init');
    case 'replay': return new ReplaySubject<string>(2);
    case 'async': return new AsyncSubject<string>();
  }
}

@Component({
  selector: 'app-root',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './app.component.html',
})
export class AppComponent {
  cards: Card[] = [
    { kind: 'subject', title: 'Subject', desc: 'No memory. Late subscribers get nothing that already happened.', subject: null, counter: 0, completed: false, subBActive: false, logA: [], logB: [], current: 'n/a' },
    { kind: 'behavior', title: 'BehaviorSubject', desc: 'Always has a current value. New subscribers get it immediately.', subject: null, counter: 0, completed: false, subBActive: false, logA: [], logB: [], current: 'init' },
    { kind: 'replay', title: 'ReplaySubject(2)', desc: 'Replays the last 2 values to every new subscriber.', subject: null, counter: 0, completed: false, subBActive: false, logA: [], logB: [], current: '—' },
    { kind: 'async', title: 'AsyncSubject', desc: 'Emits nothing until complete() — then only the final value.', subject: null, counter: 0, completed: false, subBActive: false, logA: [], logB: [], current: 'not completed yet' },
  ];

  constructor() {
    this.cards.forEach(c => this.initCard(c));
  }

  private initCard(c: Card) {
    c.subject = makeSubject(c.kind);
    c.subASub = c.subject.subscribe({
      next: (v: string) => c.logA.push(this.stamp() + '  next → ' + v),
      complete: () => c.logA.push(this.stamp() + '  complete()'),
    });
  }

  private stamp(): string {
    const d = new Date();
    return d.toTimeString().slice(0, 8) + '.' + String(d.getMilliseconds()).padStart(3, '0');
  }

  emit(c: Card) {
    if (c.completed) return;
    c.counter++;
    c.subject.next('v' + c.counter);
    this.updateCurrent(c);
  }

  lateJoin(c: Card) {
    if (c.subBActive) return;
    c.subBActive = true;
    c.logB.push(this.stamp() + '  subscribing now…');
    c.subBSub = c.subject.subscribe({
      next: (v: string) => c.logB.push(this.stamp() + '  next → ' + v),
      complete: () => c.logB.push(this.stamp() + '  complete()'),
    });
  }

  complete(c: Card) {
    if (c.completed) return;
    c.completed = true;
    c.subject.complete();
    this.updateCurrent(c);
  }

  reset(c: Card) {
    c.subASub?.unsubscribe();
    c.subBSub?.unsubscribe();
    c.counter = 0;
    c.completed = false;
    c.subBActive = false;
    c.logA = [];
    c.logB = [];
    this.initCard(c);
    this.updateCurrent(c);
  }

  private updateCurrent(c: Card) {
    if (c.kind === 'behavior') c.current = c.subject.value;
    else if (c.kind === 'replay') c.current = c.counter === 0 ? '—' : `last ${Math.min(c.counter, 2)} of ${c.counter} emitted`;
    else if (c.kind === 'async') c.current = c.completed ? `completed → v${c.counter}` : 'not completed yet';
  }
}

