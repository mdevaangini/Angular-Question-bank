`data.service.ts` — shared service. `latestData` is the shared signal that a late, uncancelled response could leak into:

```typescript
import { Injectable, signal } from '@angular/core';
import { Observable, of, throwError, timer } from 'rxjs';
import { delay, mergeMap } from 'rxjs/operators';

export interface PageResult {
  page: string;
  value: string;
}

@Injectable({ providedIn: 'root' })
export class DataService {
  // Shared state written to by whichever request resolves last. This is
  // what lets a late, uncancelled response "leak" stale data onto
  // whatever page happens to be showing right now.
  latestData = signal<PageResult | null>(null);

  fetchSlowData(page: string, delayMs: number, shouldFail: boolean): Observable<PageResult> {
    if (shouldFail) {
      // NOTE: throwError(...).pipe(delay(ms)) would NOT actually delay the
      // error - RxJS's delay() only delays next/complete, not error
      // notifications. timer(ms) + mergeMap is the correct way to make an
      // error happen after a delay.
      return timer(delayMs).pipe(
        mergeMap(() => throwError(() => new Error(`${page} request failed`)))
      );
    }
    return of({ page, value: `data-${Math.floor(Math.random() * 1000)}` }).pipe(delay(delayMs));
  }
}
```

`page-a.component.ts` — fires a slow request that fails, cancels it with `takeUntilDestroyed` only when "safe mode" is on (so you can compare both behaviors):

```typescript
import { Component, DestroyRef, OnDestroy, inject } from '@angular/core';
import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
import { DataService } from './data.service';
import { EventLogService } from './event-log.service';
import { SettingsService } from './settings.service';

@Component({
  selector: 'app-page-a',
  standalone: true,
  template: `
    <div class="page">
      <h2>Page A</h2>
      <p>This page fires a slow (3s) request that FAILS. Click "Page B" before it resolves.</p>
    </div>
  `,
})
export class PageAComponent implements OnDestroy {
  private data = inject(DataService);
  private log = inject(EventLogService);
  private settings = inject(SettingsService);
  private destroyRef = inject(DestroyRef);

  constructor() {
    const safe = this.settings.safeMode();
    this.log.add(`Page A mounted (safe mode: ${safe ? 'ON' : 'OFF'}) - starting 3s request that will fail...`);

    let request$ = this.data.fetchSlowData('Page A', 3000, true);
    if (safe) {
      request$ = request$.pipe(takeUntilDestroyed(this.destroyRef));
    }

    request$.subscribe({
      next: (result) => {
        this.data.latestData.set(result);
        this.log.add(`Page A request SUCCEEDED late: ${JSON.stringify(result)}`);
      },
      error: (err) => {
        this.log.add(`Page A request FAILED (fired even though you already left Page A): ${err.message}`);
      },
    });
  }

  ngOnDestroy(): void {
    this.log.add('Page A destroyed (navigated away)');
  }
}
```

`page-b.component.ts` — same pattern, but its request succeeds (so you can see the stale-data leak):

```typescript
import { Component, DestroyRef, OnDestroy, inject } from '@angular/core';
import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
import { DataService } from './data.service';
import { EventLogService } from './event-log.service';
import { SettingsService } from './settings.service';

@Component({
  selector: 'app-page-b',
  standalone: true,
  template: `
    <div class="page">
      <h2>Page B</h2>
      <p>This page fires a slow (5s) request that SUCCEEDS. Click "Page A" before it resolves to see the stale-data leak.</p>
    </div>
  `,
})
export class PageBComponent implements OnDestroy {
  private data = inject(DataService);
  private log = inject(EventLogService);
  private settings = inject(SettingsService);
  private destroyRef = inject(DestroyRef);

  constructor() {
    const safe = this.settings.safeMode();
    this.log.add(`Page B mounted (safe mode: ${safe ? 'ON' : 'OFF'}) - starting a slow (5s) request...`);

    let request$ = this.data.fetchSlowData('Page B', 5000, false);
    if (safe) {
      request$ = request$.pipe(takeUntilDestroyed(this.destroyRef));
    }

    request$.subscribe({
      next: (result) => {
        this.data.latestData.set(result);
        this.log.add(`Page B request succeeded: ${JSON.stringify(result)}`);
      },
      error: (err) => {
        this.log.add(`Page B request failed: ${err.message}`);
      },
    });
  }

  ngOnDestroy(): void {
    this.log.add('Page B destroyed (navigated away)');
  }
}
