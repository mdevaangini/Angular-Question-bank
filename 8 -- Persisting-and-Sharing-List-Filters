`src/app/app.routes.ts`:

```ts
import { Routes } from '@angular/router';
import { OrdersListComponent } from './orders-list/orders-list.component';
import { OrderDetailComponent } from './order-detail/order-detail.component';

export const routes: Routes = [
  { path: '', redirectTo: 'orders', pathMatch: 'full' },
  { path: 'orders', component: OrdersListComponent },
  { path: 'orders/:id', component: OrderDetailComponent },
];
```

`src/app/orders-list/orders-list.component.ts`:

```ts
import { Component, computed, inject, signal } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { ActivatedRoute, Router, RouterLink, NavigationEnd } from '@angular/router';
import { toSignal } from '@angular/core/rxjs-interop';
import { filter } from 'rxjs';
import { ORDERS } from '../models/order';

@Component({
  selector: 'app-orders-list',
  standalone: true,
  imports: [CommonModule, FormsModule, RouterLink],
  templateUrl: './orders-list.component.html',
})
export class OrdersListComponent {
  private route = inject(ActivatedRoute);
  private router = inject(Router);

  // SOURCE OF TRUTH for filters is the URL's query params -- NOT a plain
  // class field. That is what makes the filters survive navigating away
  // to the detail page and back: the URL never changes just because the
  // component instance was destroyed and recreated by the router.
  private queryParamMap = toSignal(this.route.queryParamMap, {
    initialValue: this.route.snapshot.queryParamMap,
  });

  status = computed(() => this.queryParamMap().get('status') ?? 'all');
  search = computed(() => this.queryParamMap().get('q') ?? '');

  orders = ORDERS;

  filteredOrders = computed(() => {
    const status = this.status();
    const search = this.search().toLowerCase();
    return this.orders.filter((o) => {
      const matchesStatus = status === 'all' || o.status === status;
      const matchesSearch = !search || o.customer.toLowerCase().includes(search);
      return matchesStatus && matchesSearch;
    });
  });

  // Mirrors the address bar so users can visibly see/copy it. This IS the
  // shareable filtered view -- nothing extra needs to be built for sharing.
  shareableUrl = signal(window.location.href);

  constructor() {
    this.router.events
      .pipe(filter((e): e is NavigationEnd => e instanceof NavigationEnd))
      .subscribe(() => this.shareableUrl.set(window.location.href));
  }

  setStatus(status: string): void {
    // queryParamsHandling: 'merge' keeps any OTHER query params untouched;
    // replaceUrl: true avoids flooding browser history with one entry per
    // filter tweak (so the back button still feels sane).
    this.router.navigate([], {
      relativeTo: this.route,
      queryParams: { status: status === 'all' ? null : status },
      queryParamsHandling: 'merge',
      replaceUrl: true,
    });
  }

  setSearch(value: string): void {
    this.router.navigate([], {
      relativeTo: this.route,
      queryParams: { q: value || null },
      queryParamsHandling: 'merge',
      replaceUrl: true,
    });
  }
}
```

