import { Component } from '@angular/core';

/**
 * Angular's default ViewEncapsulation (Emulated) scopes component CSS by
 * injecting a real <style> element into the document at RUNTIME, with an
 * attribute selector Angular adds to scope it to this component's elements.
 * That injected <style> tag has no nonce and no hash — from the browser's
 * point of view it is exactly what a strict CSP calls an "inline style",
 * indistinguishable from an attacker-injected <style> tag. Under
 * `style-src 'self'` with no `'unsafe-inline'` and no nonce, the browser
 * refuses to parse/apply it. There is no build-time way to turn THIS kind
 * of styling (declared via the `styles:` array below) into an external
 * file — Angular always injects it dynamically for Emulated/ShadowDom
 * encapsulation, regardless of dev vs prod build.
 */
@Component({
  selector: 'app-styled-inline',
  standalone: true,
  styles: [
    `.inline-box {
      background: #dc2626;
      color: white;
      padding: 16px;
      border-radius: 8px;
      font-weight: 600;
      border: 3px dashed #fbbf24;
    }`,
  ],
  template: `
    <div class="inline-box">
      Styled via this component's own styles: [] array — an inline &lt;style&gt; tag Angular injects at runtime.
    </div>
  `,
})
export class StyledInlineComponent {}
```

