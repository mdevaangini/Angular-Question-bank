### `form-schema.model.ts`

```ts
// Defines the contract between backend JSON and the frontend renderer.
// Keeping this as a strict TypeScript interface means schema mistakes
// from the backend surface as compile-time/type errors in consuming code.

export interface FieldValidator {
  type: 'required' | 'email' | 'minLength' | 'maxLength' | 'pattern';
  value?: any;   // e.g. 3 for minLength, or a regex string for pattern
}

export interface FieldConditional {
  dependsOn: string; // name of the controlling field
  value: any;        // this field is visible only when dependsOn === value
}

export interface FormFieldSchema {
  name: string;
  label: string;
  type: 'text' | 'email' | 'number' | 'select' | 'checkbox';
  options?: { label: string; value: any }[]; // used for 'select' type
  validators?: FieldValidator[];
  conditional?: FieldConditional;
  defaultValue?: any;
}

export interface FormSchema {
  fields: FormFieldSchema[];
}
```

### `validator-factory.ts`

```ts
import { ValidatorFn, Validators } from '@angular/forms';
import { FieldValidator } from './form-schema.model';

// Translates schema-defined validator descriptions into real Angular ValidatorFns.
// This is the key piece that makes validation "data-driven" instead of hardcoded.
export function buildValidators(validatorDefs: FieldValidator[] = []): ValidatorFn[] {
  return validatorDefs.map((v) => {
    switch (v.type) {
      case 'required':
        return Validators.required;
      case 'email':
        return Validators.email;
      case 'minLength':
        return Validators.minLength(v.value);
      case 'maxLength':
        return Validators.maxLength(v.value);
      case 'pattern':
        return Validators.pattern(v.value);
      default:
        return Validators.nullValidator;
    }
  });
}
```

### `dynamic-form.component.ts`

```ts
import { Component, EventEmitter, Input, OnInit, Output } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormBuilder, FormGroup, ReactiveFormsModule } from '@angular/forms';
import { FormSchema, FormFieldSchema } from './form-schema.model';
import { buildValidators } from './validator-factory';

@Component({
  selector: 'app-dynamic-form',
  standalone: true,
  imports: [CommonModule, ReactiveFormsModule],
  templateUrl: './dynamic-form.component.html',
})
export class DynamicFormComponent implements OnInit {
  @Input() schema!: FormSchema;
  @Output() formSubmit = new EventEmitter<any>();

  form!: FormGroup;

  constructor(private fb: FormBuilder) {}

  ngOnInit(): void {
    this.buildForm();
    this.setupConditionalLogic();
  }

  // Builds one FormControl per schema field, wiring up its validators.
  private buildForm(): void {
    const group: Record<string, any> = {};
    for (const field of this.schema.fields) {
      group[field.name] = [field.defaultValue ?? '', buildValidators(field.validators)];
    }
    this.form = this.fb.group(group);
  }

  // Watches "controlling" fields and toggles validators on dependent fields.
  // IMPORTANT: clearing validators when a field is hidden is what prevents
  // a hidden required field from silently blocking submission.
  private setupConditionalLogic(): void {
    for (const field of this.schema.fields) {
      if (!field.conditional) continue;

      const { dependsOn, value } = field.conditional;
      const controllingControl = this.form.get(dependsOn);
      const dependentControl = this.form.get(field.name);
      if (!controllingControl || !dependentControl) continue;

      controllingControl.valueChanges.subscribe((val) => {
        const isVisible = val === value;
        if (isVisible) {
          dependentControl.setValidators(buildValidators(field.validators));
        } else {
          dependentControl.clearValidators();
          dependentControl.setValue('');
        }
        // Required after setValidators/clearValidators — Angular does not
        // re-run validity checks automatically.
        dependentControl.updateValueAndValidity();
      });

      // Apply correct initial state on load (in case default value already hides it).
      const initiallyVisible = controllingControl.value === value;
      if (!initiallyVisible) {
        dependentControl.clearValidators();
        dependentControl.updateValueAndValidity();
      }
    }
  }

  isVisible(field: FormFieldSchema): boolean {
    if (!field.conditional) return true;
    const controllingValue = this.form.get(field.conditional.dependsOn)?.value;
    return controllingValue === field.conditional.value;
  }

  onSubmit(): void {
    if (this.form.valid) {
      this.formSubmit.emit(this.form.value);
    } else {
      // Forces error messages to show even if the user never touched a field.
      this.form.markAllAsTouched();
    }
  }
}
```

### `dynamic-form.component.html`

```html
<form [formGroup]="form" (ngSubmit)="onSubmit()">
  <ng-container *ngFor="let field of schema.fields">
    <div class="form-field" *ngIf="isVisible(field)">
      <label [for]="field.name">{{ field.label }}</label>

      <!-- text / email / number inputs share the same markup -->
      <input
        *ngIf="field.type === 'text' || field.type === 'email' || field.type === 'number'"
        [id]="field.name"
        [type]="field.type"
        [formControlName]="field.name"
      />

      <!-- select dropdown -->
      <select *ngIf="field.type === 'select'" [id]="field.name" [formControlName]="field.name">
        <option value="">-- Select --</option>
        <option *ngFor="let opt of field.options" [value]="opt.value">{{ opt.label }}</option>
      </select>

      <!-- checkbox -->
      <input
        *ngIf="field.type === 'checkbox'"
        type="checkbox"
        [id]="field.name"
        [formControlName]="field.name"
      />

      <div class="error" *ngIf="form.get(field.name)?.invalid && form.get(field.name)?.touched">
        {{ field.label }} is invalid
      </div>
    </div>
  </ng-container>

  <button type="submit">Submit</button>
</form>
```

### `app.component.ts` (usage — this is the JSON schema "from the server")

```ts
import { Component } from '@angular/core';
import { DynamicFormComponent } from './dynamic-form.component';
import { FormSchema } from './form-schema.model';

@Component({
  selector: 'app-root',
  standalone: true,
  imports: [DynamicFormComponent],
  template: `<app-dynamic-form [schema]="schema" (formSubmit)="onSubmit($event)"></app-dynamic-form>`,
})
export class AppComponent {
  // In a real app, this would come from an HTTP call, e.g.
  // this.http.get<FormSchema>('/api/forms/onboarding')
  schema: FormSchema = {
    fields: [
      {
        name: 'fullName',
        label: 'Full Name',
        type: 'text',
        validators: [{ type: 'required' }, { type: 'minLength', value: 3 }],
      },
      {
        name: 'email',
        label: 'Email',
        type: 'email',
        validators: [{ type: 'required' }, { type: 'email' }],
      },
      {
        name: 'accountType',
        label: 'Account Type',
        type: 'select',
        options: [
          { label: 'Individual', value: 'individual' },
          { label: 'Business', value: 'business' },
        ],
        validators: [{ type: 'required' }],
      },
      {
        // Only shown, and only required, when accountType === 'business'
        name: 'companyName',
        label: 'Company Name',
        type: 'text',
        validators: [{ type: 'required' }],
        conditional: { dependsOn: 'accountType', value: 'business' },
      },
    ],
  };

  onSubmit(value: any) {
    console.log('Form submitted:', value);
  }
}
```

## 5. Example Explanation / Execution Flow

1. `AppComponent` holds a `FormSchema` object (imagine this arrived via an HTTP GET from `/api/forms/onboarding`).
2. `DynamicFormComponent` receives it via `[schema]` and, in `ngOnInit`, builds a `FormGroup` with one control per field (`fullName`, `email`, `accountType`, `companyName`), attaching validators translated from the schema.
3. `setupConditionalLogic()` subscribes to `accountType`'s `valueChanges`. Initially `accountType` is empty, so `companyName` is hidden and has **no** validators (it was cleared on init).
4. The user selects "Business" from the dropdown. The subscription fires, sees `val === 'business'` matches the conditional rule, and re-applies `companyName`'s `required` validator via `setValidators` + `updateValueAndValidity()`.
5. The template's `isVisible(field)` re-evaluates on every change detection cycle, so `companyName` becomes visible in the DOM at the same time its validator becomes active.
6. If the user switches back to "Individual", the subscription clears `companyName`'s validators and resets its value — so a stale, invisible value can't be submitted accidentally.
7. On submit, `form.valid` reflects only the *currently relevant* fields — hidden fields never block submission, and visible required fields are correctly enforced.

## 6. When should we use it?

- Admin-configurable forms (surveys, intake forms, onboarding flows) where non-engineers manage field configuration.
- Multi-tenant SaaS products where different customers need different form fields without separate builds.
- Large enterprise apps with dozens of structurally similar forms (reduces duplicated form components).
- Low-code/no-code form builders, workflow engines, or CMS-driven content forms.

Avoid it for a handful of simple, stable, one-off forms — the abstraction overhead isn't worth it there; a normal hardcoded reactive form is simpler and easier to debug.

## 7. Advantages / Disadvantages

**Advantages**

- Form changes ship via backend config, not frontend deploys.
- One reusable rendering engine instead of N near-duplicate form components.
- Centralizes validation logic, reducing drift between similar forms.
- Naturally supports multi-tenant/customizable UIs.

**Disadvantages**

- Harder to debug — the "form definition" isn't visible directly in the component code, you have to trace through the schema.
- Custom/complex UI per field (rich pickers, multi-step wizards, cross-field logic) is harder to express generically in JSON.
- Type safety is weaker at the boundary — the schema comes from the network, so it must be validated/defended against (malformed schema, unknown `type` values, etc.).
- Testing requires testing the *engine* thoroughly (since one bug affects every dynamically-rendered form), plus testing individual schemas.

## 8. Common Interview Traps

- **Forgetting to clear validators on hidden fields.** This is the #1 trap — a hidden required field left with `Validators.required` will make `form.valid` false forever, and the user will be stuck with no visible error to explain why.
- **Forgetting `updateValueAndValidity()`** after `setValidators`/`clearValidators` — Angular does not automatically re-run validation; you must call this explicitly.
- Confusing **template-driven forms** with **reactive forms** — dynamic form generation is almost always done with Reactive Forms because `FormGroup`/`FormControl` can be built programmatically; template-driven forms are declared in the template and don't fit this pattern well.
- Not resetting a hidden field's **value** (only clearing validators) — this can leak stale/irrelevant data into the submitted payload.
- Assuming the schema is always well-formed — interviewers may probe on how you'd validate/sanitize a schema coming from an external/backend source (e.g., unknown `type`, missing `name`).
- Not considering **circular conditional dependencies** (field A depends on B, B depends on A) — a good candidate mentions this edge case even briefly.

## 9. Interview Follow-up Questions

**Q: Why use Reactive Forms instead of Template-driven Forms for this?**
Answer: Reactive Forms let you construct `FormGroup`/`FormControl` instances programmatically in TypeScript, which is essential when the form structure isn't known until runtime. Template-driven forms rely on directives declared directly in the template, which doesn't work for a schema-driven, dynamically generated structure.

**Q: How would you handle a field type you don't recognize in the schema (e.g., a new `'date-range'` type added by backend before frontend supports it)?**
Answer: Render a fallback/unsupported-field placeholder (or skip it) rather than crashing, and log a warning. This keeps the form usable even if frontend and backend versions drift slightly.

**Q: How would you support cross-field validation (e.g., "confirm password must match password")?**
Answer: Extend the schema to describe a validator at the `FormGroup` level (not per-control), e.g. `{ type: 'fieldsMatch', fields: ['password', 'confirmPassword'] }`, and have the builder attach it as a group-level custom validator via `this.fb.group(controls, { validators: crossFieldValidatorFn })`.

**Q: How do you unit test a dynamic form engine like this?**
Answer: Test the engine independently of any specific schema — feed it a few representative mock schemas (required field, conditional field, select with options) and assert on the resulting `FormGroup`'s validity, control presence, and validator behavior, rather than testing against one hardcoded business form.

**Q: What if the conditional logic needs to depend on more than one field, or use a comparison operator other than equality?**
Answer: Generalize `FieldConditional` to hold an array of conditions with operators (`equals`, `notEquals`, `in`, `greaterThan`) and a combinator (`AND`/`OR`), then evaluate them in `isVisible()` instead of a single strict equality check.

## 10. Interview-Ready Answer

"To build a fully dynamic form, I avoid hardcoding controls in the template and instead treat the form's structure as data. The backend sends a JSON schema describing each field — its name, type, validators, and any conditional visibility rules. On the frontend, I use Angular Reactive Forms because `FormGroup` and `FormControl` can be constructed programmatically. I write a validator factory that maps schema validator definitions like `{ type: 'required' }` into real `ValidatorFn`s, and a generic component that loops over the schema fields with `*ngFor`, switching on `field.type` to render the right input, all bound through `formControlName`. For conditional visibility, I subscribe to the `valueChanges` of the controlling field, and — this is the part people often miss — when a field becomes hidden, I don't just hide it in the template, I also clear its validators and reset its value, then call `updateValueAndValidity()`. Otherwise a hidden required field silently blocks form submission. This pattern means product or backend teams can change form fields through config, without a frontend deploy, while the frontend owns one well-tested rendering engine."

## 11. Quick Revision

- **What:** Render a form's controls, validators, and visibility rules entirely from a JSON schema instead of hardcoding them in the template.
- **Why:** So form structure changes don't require frontend code changes/deploys; supports multi-tenant/admin-configurable forms.
- **Problem solved:** Decouples form definition (data) from form rendering (code); avoids duplicated near-identical form components.
- **How:** Reactive Forms + a validator factory (schema validator → `ValidatorFn`) + generic template with `*ngFor`/type switch + `valueChanges` subscriptions for conditional visibility.
- **Use when:** Admin-configurable forms, multi-tenant apps, many structurally similar forms.
- **Important:** Always clear validators (and reset value) on a field when it becomes hidden, then call `updateValueAndValidity()`.
- **Remember:** Reactive Forms only — Template-driven forms can't be built programmatically at runtime.

## Think of it as:

A form "interpreter" — the JSON schema is the program, and your `DynamicFormComponent` is the interpreter that reads it and produces a live, validated UI, the same way a rendering engine reads HTML/CSS and produces pixels.
