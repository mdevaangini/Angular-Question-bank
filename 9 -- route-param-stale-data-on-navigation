  standalone: true,
  imports: [CommonModule],
  template: `
    <div class="user-card stale-warning">
      <span class="badge">component instance created: {{ instanceCreatedAt }}</span>
      <h3>{{ user?.name }}</h3>
      <p>{{ user?.email }}</p>
      <p class="hint">Fetched once in ngOnInit via route.snapshot.paramMap — never re-reads on navigation.</p>
    </div>
  `,
})
export class BuggyUserDetailComponent implements OnInit {
  private route = inject(ActivatedRoute);
  private userService = inject(UserService);
  user?: User;
  instanceCreatedAt = new Date().toLocaleTimeString();

  ngOnInit() {
    const id = this.route.snapshot.paramMap.get('id')!;
