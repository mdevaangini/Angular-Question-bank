https://stackblitz.com/edit/angular-w2iaegf3

```ts
// loading-context.ts
import { HttpContextToken } from '@angular/common/http';

export const SKIP_LOADING = new HttpContextToken<boolean>(() => false);
```

```ts
// loading.service.ts
import { Injectable } from '@angular/core';
import { BehaviorSubject, timer } from 'rxjs';
import { distinctUntilChanged, switchMap, map } from 'rxjs/operators';
import { toSignal } from '@angular/core/rxjs-interop';

const SHOW_DELAY_MS = 150;
const MIN_VISIBLE_MS = 400;

@Injectable({ providedIn: 'root' })
export class LoadingService {
  private activeRequests = 0;
  private rawLoading = new BehaviorSubject<boolean>(false);

  private loading$ = this.rawLoading.pipe(
    distinctUntilChanged(),
    switchMap(isLoading =>
      isLoading
        ? timer(SHOW_DELAY_MS).pipe(map(() => true))
        : timer(MIN_VISIBLE_MS).pipe(map(() => false))
    ),
    distinctUntilChanged()
  );

  loading = toSignal(this.loading$, { initialValue: false });

  show(): void {
    this.activeRequests++;
    if (this.activeRequests === 1) {
      this.rawLoading.next(true);
    }
  }

  hide(): void {
    this.activeRequests = Math.max(0, this.activeRequests - 1);
    if (this.activeRequests === 0) {
      this.rawLoading.next(false);
    }
  }
}
```

```ts
// loading.interceptor.ts
import { HttpInterceptorFn } from '@angular/common/http';
import { inject } from '@angular/core';
import { finalize } from 'rxjs/operators';
import { LoadingService } from './loading.service';
import { SKIP_LOADING } from './loading-context';

export const loadingInterceptor: HttpInterceptorFn = (req, next) => {
  if (req.context.get(SKIP_LOADING)) {
    return next(req); // background/silent request — never counted
  }

  const loadingService = inject(LoadingService);
  loadingService.show();

  return next(req).pipe(
    finalize(() => loadingService.hide())
  );
};
```

```ts
// fake-backend.interceptor.ts (demo-only: simulates a server with an artificial delay)
import { HttpInterceptorFn, HttpResponse } from '@angular/common/http';
import { of } from 'rxjs';
import { delay } from 'rxjs/operators';

export const fakeBackendInterceptor: HttpInterceptorFn = (req, next) => {
  if (!req.url.startsWith('/api/')) {
    return next(req);
  }

  const waitMs = Number(req.params.get('delay')) || 300;

  return of(
    new HttpResponse({ status: 200, body: { ok: true, url: req.url, waitMs } })
  ).pipe(delay(waitMs));
};
```

