```ts
// app.component.ts
import { Component, OnInit, inject, signal } from '@angular/core';
import { HttpClient, HttpContext, HttpParams } from '@angular/common/http';
import { exhaustMap, interval } from 'rxjs';
import { LoadingBarComponent } from './loading-bar.component';
import { SKIP_LOADING } from './loading-context';

@Component({
  selector: 'app-root',
  standalone: true,
  imports: [LoadingBarComponent],
  templateUrl: './app.component.html'
})
export class AppComponent implements OnInit {
  private http = inject(HttpClient);

  log = signal<string[]>([]);

  ngOnInit(): void {
    interval(5000)
      .pipe(
        exhaustMap(() =>
          this.http.get('/api/poll', {
            params: new HttpParams().set('delay', 6000),
            context: new HttpContext().set(SKIP_LOADING, true)
          })
        )
      )
      .subscribe(() => this.addLog('Background poll finished (6s, excluded from bar)'));
  }

  quickRequest(): void {
    this.http
      .get('/api/quick', { params: new HttpParams().set('delay', 200) })
      .subscribe(() => this.addLog('Quick request finished (200ms)'));
  }

  slowRequest(): void {
    this.http
      .get('/api/slow', { params: new HttpParams().set('delay', 2000) })
      .subscribe(() => this.addLog('Slow request finished (2000ms)'));
  }

  private addLog(message: string): void {
    this.log.update(entries => [message, ...entries].slice(0, 8));
  }
}
```

