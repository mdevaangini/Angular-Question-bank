import { HttpInterceptorFn, HttpResponse } from '@angular/common/http';
import { of } from 'rxjs';
import { delay } from 'rxjs/operators';

const TAKEN_USERNAMES = new Set(['admin', 'root', 'test', 'ada']);

export const fakeBackendInterceptor: HttpInterceptorFn = (req, next) => {
  if (req.url === '/api/username-available') {
    const username = (req.params.get('username') || '').toLowerCase();
    const available = !TAKEN_USERNAMES.has(username);
    return of(new HttpResponse({ status: 200, body: { available } })).pipe(delay(500));
  }
  return next(req);
};
