```typescript
// naive-list.component.ts - deliberately DEFAULT change detection.
// This is the "before" component: it gets re-checked on every single
// change-detection cycle Angular runs, no matter what triggered that
// cycle, even though its own data never changes.
import { Component, Input } from '@angular/core';

@Component({
  selector: 'app-naive-list',
  standalone: true,
  template: `
    <div class="list-box naive">
      <h2>Naive list (default change detection)</h2>
      <p>Check count: <b>{{ cdCheckCount }}</b></p>
      @for (item of items; track item) {
        <span>{{ item }}</span>
      }
    </div>
  `,
})
export class NaiveListComponent {
  @Input({ required: true }) items!: number[];

  private _checks = 0;
  get cdCheckCount(): number {
    return ++this._checks;
  }
}
```

```typescript
// onpush-list.component.ts - OnPush + a stable "items" reference that's
// never reassigned. This one should stay flat no matter how often change
// detection runs elsewhere in the app.
import { ChangeDetectionStrategy, Component, Input } from '@angular/core';

@Component({
  selector: 'app-onpush-list',
  standalone: true,
  changeDetection: ChangeDetectionStrategy.OnPush,
  template: `
    <div class="list-box onpush">
      <h2>OnPush list (stable input reference)</h2>
      <p>Check count: <b>{{ cdCheckCount }}</b></p>
      @for (item of items; track item) {
        <span>{{ item }}</span>
      }
    </div>
  `,
})
export class OnpushListComponent {
  @Input({ required: true }) items!: number[];

  private _checks = 0;
  get cdCheckCount(): number {
    return ++this._checks;
  }
}
```

```typescript
// app.component.ts - a toggleable timer that demonstrates the problem
// (NAIVE mode) and the fix (FIXED mode) side by side.
import { Component, NgZone, OnDestroy, ChangeDetectorRef, inject, signal } from '@angular/core';
import { NaiveListComponent } from './naive-list.component';
import { OnpushListComponent } from './onpush-list.component';

@Component({
  selector: 'app-root',
  standalone: true,
  imports: [NaiveListComponent, OnpushListComponent],
  template: `
    <h1>Change Detection Running Too Often - Diagnose &amp; Fix</h1>
    <p>Clock: <b>{{ time() }}</b></p>
    <button (click)="toggleMode()">
      Timer mode: {{ insideZone() ? 'NAIVE (setInterval inside Angular zone)' : 'FIXED (outside zone + local detectChanges)' }} - click to switch
    </button>
    <p class="hint">Neither list's data ever changes. Watch both check counts while the clock ticks, in both modes.</p>
    <div class="layout">
      <app-naive-list [items]="items" />
      <app-onpush-list [items]="items" />
    </div>
  `,
})
export class AppComponent implements OnDestroy {
  private ngZone = inject(NgZone);
  private cdr = inject(ChangeDetectorRef);

  insideZone = signal(true);
  time = signal(new Date().toLocaleTimeString());

  // Stable reference, created once, never reassigned - shared by both lists.
  items = Array.from({ length: 300 }, (_, i) => i);

  private intervalId: ReturnType<typeof setInterval> | undefined;

  constructor() {
    this.startTimer();
  }

  toggleMode(): void {
    this.stopTimer();
    this.insideZone.update((v) => !v);
    this.startTimer();
  }

  private startTimer(): void {
    if (this.insideZone()) {
      // NAIVE: setInterval is patched by zone.js, so every tick schedules a
      // full, app-wide change-detection cycle from the root - exactly as if
      // the user clicked something, every 300ms, forever.
      this.intervalId = setInterval(() => {
        this.time.set(new Date().toLocaleTimeString());
      }, 300);
    } else {
      // FIXED: run the timer outside Angular's zone entirely, so ticking
      // does NOT schedule an app-wide change-detection cycle at all. Then
      // run a LOCAL, targeted check with detectChanges() - this only walks
      // this component and its children, and still respects OnPush skip
      // rules for the OnPush child along the way.
      this.ngZone.runOutsideAngular(() => {
        this.intervalId = setInterval(() => {
          this.time.set(new Date().toLocaleTimeString());
          this.cdr.detectChanges();
        }, 300);
      });
    }
  }

  private stopTimer(): void {
    clearInterval(this.intervalId);
  }

  ngOnDestroy(): void {
    this.stopTimer();
  }
}
```

