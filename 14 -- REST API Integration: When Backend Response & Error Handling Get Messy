```ts
// normalize-error.ts
import { HttpErrorResponse } from '@angular/common/http';
import { ApiError } from './api-error.model';

const RETRYABLE_STATUSES = new Set([0, 408, 429, 502, 503, 504]);

export function normalizeHttpError(err: HttpErrorResponse): ApiError {
  if (err.error && typeof err.error === 'object' && err.error.error) {
    const inner = err.error.error;
    return {
      code: inner.code || 'UNKNOWN',
      message: inner.message || 'Something went wrong',
      retryable: RETRYABLE_STATUSES.has(err.status),
      status: err.status
    };
  }

  if (typeof err.error === 'string' && err.error.trim().startsWith('<')) {
    // A gateway/proxy returned an HTML error page instead of JSON
    return {
      code: 'GATEWAY_ERROR',
      message: 'The server is temporarily unavailable. Please try again shortly.',
      retryable: true,
      status: err.status
    };
  }

  if (err.status === 0) {
    return {
      code: 'NETWORK_ERROR',
      message: 'Could not reach the server. Check your connection.',
      retryable: true,
      status: 0
    };
  }

  return {
    code: 'HTTP_' + err.status,
    message: err.message || 'Unexpected error',
    retryable: RETRYABLE_STATUSES.has(err.status),
    status: err.status
  };
}

export function normalizeLogicalError(body: any, status: number): ApiError {
  const inner = body?.error ?? {};
  return {
    code: inner.code || 'LOGICAL_ERROR',
    message: inner.message || 'Request failed',
    retryable: false,
    status
  };
}
```

```ts
// retry-strategy.ts
import { throwError, timer } from 'rxjs';
import { ApiError } from './api-error.model';

const MAX_RETRIES = 3;

export function retryableErrorsOnly(error: ApiError, retryCount: number) {
  if (!error?.retryable || retryCount > MAX_RETRIES) {
    return throwError(() => error);
  }

  const backoffMs = Math.min(1000 * 2 ** (retryCount - 1), 8000);
  const jitterMs = Math.random() * 300;
  return timer(backoffMs + jitterMs);
}
```

```ts
// api-error.interceptor.ts
import { HttpEventType, HttpInterceptorFn } from '@angular/common/http';
import { map, catchError, throwError } from 'rxjs';
import { normalizeHttpError, normalizeLogicalError } from './normalize-error';

export const apiErrorInterceptor: HttpInterceptorFn = (req, next) => {
  return next(req).pipe(
    map(event => {
      if (
        event.type === HttpEventType.Response &&
        event.body &&
        typeof event.body === 'object' &&
        (event.body as any).success === false
      ) {
        // Transport succeeded (200 OK) but the payload signals a logical failure
        throw normalizeLogicalError(event.body, event.status);
      }
      return event;
    }),
    catchError(err => {
      if (err && err.code) {
        return throwError(() => err); // already normalized above
      }
      return throwError(() => normalizeHttpError(err));
    })
  );
};
```

```ts
// fake-backend.interceptor.ts (demo-only: simulates three real backend quirks)
import { HttpInterceptorFn, HttpResponse, HttpErrorResponse } from '@angular/common/http';
import { of, throwError } from 'rxjs';
import { delay } from 'rxjs/operators';

let flakyAttempts = 0;

export const fakeBackendInterceptor: HttpInterceptorFn = (req, next) => {
  if (req.url === '/api/orders') {
    // Quirk #1: HTTP 200, but the body says the request logically failed
    return of(
      new HttpResponse({
        status: 200,
        body: {
          success: false,
          error: { code: 'ORDER_LOCKED', message: 'This order is locked for editing by another user.' }
        }
      })
    ).pipe(delay(300));
  }

  if (req.url === '/api/flaky') {
    // Quirk #2: transient 503s that succeed after a couple of retries
    flakyAttempts++;
    if (flakyAttempts < 3) {
      return throwError(() =>
        new HttpErrorResponse({ status: 503, statusText: 'Service Unavailable', url: req.url })
      ).pipe(delay(300));
    }
    return of(
      new HttpResponse({ status: 200, body: { success: true, data: { id: 42, attempt: flakyAttempts } } })
    ).pipe(delay(300));
  }

  if (req.url === '/api/gateway-timeout') {
    // Quirk #3: a reverse proxy returns its own HTML error page, not JSON
    return throwError(() =>
      new HttpErrorResponse({
        status: 504,
        statusText: 'Gateway Timeout',
        url: req.url,
        error: '<html><body><h1>504 Gateway Time-out</h1></body></html>'
      })
    ).pipe(delay(300));
  }

  return next(req);
};
```

```ts
// app.component.ts
import { Component, OnInit, inject, signal } from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { retry } from 'rxjs/operators';
import { retryableErrorsOnly } from './retry-strategy';
import { ApiError } from './api-error.model';

@Component({
  selector: 'app-root',
  standalone: true,
  templateUrl: './app.component.html'
})
export class AppComponent implements OnInit {
  private http = inject(HttpClient);

  log = signal<string[]>([]);

  ngOnInit(): void {
    this.callOrders();
    this.callFlaky();
    this.callGatewayTimeout();
  }

  callOrders(): void {
    this.http.get('/api/orders').subscribe({
      next: () => this.addLog('orders -> unexpected success'),
      error: (err: ApiError) => this.addLog(
        'orders -> logical error caught even though transport was 200 OK: [' + err.code + '] ' + err.message
      )
    });
  }

  callFlaky(): void {
    this.http.get('/api/flaky').pipe(
      retry({ count: 3, delay: retryableErrorsOnly })
    ).subscribe({
      next: () => this.addLog('flaky -> succeeded after automatic retries with backoff'),
      error: (err: ApiError) => this.addLog('flaky -> gave up: [' + err.code + '] ' + err.message)
    });
  }

  callGatewayTimeout(): void {
    this.http.get('/api/gateway-timeout').pipe(
      retry({ count: 3, delay: retryableErrorsOnly })
    ).subscribe({
      next: () => this.addLog('gateway-timeout -> unexpected success'),
      error: (err: ApiError) => this.addLog(
        'gateway-timeout -> retried then normalized non-JSON HTML error into: [' + err.code + '] ' + err.message
      )
    });
  }

  private addLog(message: string): void {
    this.log.update(entries => [...entries, message]);
  }
}
```

